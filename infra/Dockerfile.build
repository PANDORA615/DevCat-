# syntax=docker/dockerfile:1
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=secret,id=ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/ca install -y --no-install-recommends \
    ca-certificates git curl unzip xz-utils zip clang cmake ninja-build pkg-config \
    libgtk-3-dev liblzma-dev libsecret-1-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-plugins-good libsqlite3-dev libstdc++-12-dev xvfb xauth imagemagick \
    python3 dotnet-sdk-8.0 openjdk-21-jdk-headless golang-go nodejs gcc g++ rpm patchelf && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /work
